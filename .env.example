# Copiá este archivo como .env (o .env.local) y completá los valores.
# Ese archivo NO se sube a GitHub (está en .gitignore).
# En Vercel se cargan en Settings → Environment Variables.

# ImgBB: https://api.imgbb.com/ (con tu cuenta iniciada)
VITE_IMGBB_KEY=tu_api_key_aca

# Firebase: Configuración del proyecto → General → Tus apps → firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
